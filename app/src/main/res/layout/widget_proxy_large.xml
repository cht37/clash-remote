<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="2dp" android:background="@drawable/widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/widget_title_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/app_name">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_launcher_monochrome" android:tint="@color/widget_foreground" android:importantForAccessibility="no" />
            <TextView style="@style/WidgetText.Group" android:id="@+id/widget_router" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical" android:text="@string/widget_router" />
        </LinearLayout>
        <TextView style="@style/WidgetText" android:id="@+id/widget_dot" android:layout_width="6dp" android:layout_height="wrap_content" android:text="@string/widget_dot" android:textSize="6sp" android:importantForAccessibility="no" />
        <TextView style="@style/WidgetText.Time" android:id="@+id/widget_time" android:layout_width="38dp" android:layout_height="match_parent" android:text="@string/widget_pending" />
        <FrameLayout android:id="@+id/widget_refresh" android:layout_width="24dp" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_refresh">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_foreground" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="2dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView style="@style/WidgetText.Mode" android:id="@+id/widget_rule" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:text="@string/widget_rule" />
        <TextView style="@style/WidgetText.Mode" android:id="@+id/widget_global" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:text="@string/widget_global" />
        <TextView style="@style/WidgetText.Mode" android:id="@+id/widget_direct" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:text="@string/widget_direct" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_node_background" android:paddingHorizontal="6dp">
        <FrameLayout android:id="@+id/widget_node_area" android:layout_width="match_parent" android:layout_height="48dp" android:background="?android:attr/selectableItemBackground">
            <TextView style="@style/WidgetText.Node" android:id="@+id/widget_node" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_select_node" />
        </FrameLayout>
        <FrameLayout android:id="@+id/widget_configure" android:layout_width="match_parent" android:layout_height="24dp" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_select_group">
            <TextView style="@style/WidgetText.Group" android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_select_group" />
        </FrameLayout>
        <TextView style="@style/WidgetText.Error" android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/widget_select_group" />
    </LinearLayout>
</LinearLayout>

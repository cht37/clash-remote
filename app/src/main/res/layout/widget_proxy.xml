<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_title_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_launcher_monochrome"
                android:tint="@color/widget_foreground" android:contentDescription="@string/app_name" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_dot" android:layout_width="12dp" android:layout_height="wrap_content" android:text="@string/widget_dot" android:textSize="12sp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/widget_router" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/widget_router" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_refresh" android:layout_width="80dp" android:layout_height="48dp" android:orientation="vertical"
            android:gravity="center" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_refresh">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_foreground" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_pending"
                android:gravity="center" android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_rule" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp"
            android:text="@string/widget_rule" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_foreground" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_global" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp"
            android:text="@string/widget_global" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_foreground" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_direct" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/widget_direct" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_foreground" android:background="@drawable/widget_button" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp"
        android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_node_background">
        <LinearLayout android:id="@+id/widget_node_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingHorizontal="8dp"
            android:orientation="vertical" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
            <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_proxy_group"
                android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="1" />
            <TextView android:id="@+id/widget_node" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_select_node"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_select_group"
                android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_configure" android:layout_width="56dp" android:layout_height="match_parent" android:minHeight="48dp"
            android:gravity="center" android:text="@string/widget_group_button" android:textSize="12sp" android:textColor="@color/widget_secondary"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_select_group" />
    </LinearLayout>
</LinearLayout>
